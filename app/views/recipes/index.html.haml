- @page_title = "Recipes"

= render PageHeaderComponent.new(title: "Recipes", back_href: native_app? ? nil : today_path, back_label: "Back to today") do |h|
  - if @recipes.any?
    - h.with_action do
      = link_to new_recipe_path, "aria-label": "New recipe", class: "flex items-center justify-center w-11 h-11 text-primary rounded-lg hover:bg-primary-tint border border-primary transition-colors" do
        != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>'

- if @recipes.any?
  = render CardComponent.new(class: "p-2") do
    %ul.divide-y.divide-border
      - @recipes.each do |recipe|
        %li{ data: { recipe: true } }
          = link_to recipe_path(recipe), class: "flex items-center justify-between px-4 py-3 text-text hover:bg-primary-tint rounded-md transition-colors" do
            .min-w-0.flex-1.mr-3
              .font-medium.truncate= recipe.name
              .text-xs.text-text-secondary
                = "#{recipe.food.calories.round} kcal/100g"
                %span.mx-1 &middot;
                - servings = recipe.servings_in_recipe
                - servings_label = servings == servings.to_i ? servings.to_i : servings
                = pluralize(servings_label, "serving")
            != '<svg class="w-4 h-4 text-text-secondary shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>'
- else
  = render CardComponent.new(class: "p-8 text-center") do
    %p.text-text-secondary.mb-3 You haven't created any recipes yet.
    = link_to new_recipe_path do
      = render ButtonComponent.new(label: "Create your first recipe", scheme: :primary, size: :md)
