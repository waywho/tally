- @page_title = @recipe.name

= render PageHeaderComponent.new(title: @recipe.name, back_href: recipes_path, back_label: "Back to recipes")

- serving_g = @recipe.food.serving_size || 0
- serving_factor = serving_g / 100.0
- servings = @recipe.servings_in_recipe
- servings_label = servings == servings.to_i ? servings.to_i : servings
= render CardComponent.new(class: "p-4 mb-4") do
  %h2.text-base.font-bold.text-text.mb-1
    = "Per serving"
    %span.text-text-secondary.font-normal.ml-1= "(#{serving_g.round}g · #{pluralize(servings_label, 'serving')} total)"
  .flex.gap-3.mt-3.mb-3
    .flex-1.bg-primary-tint.rounded-md.px-3.py-2.text-center
      .text-xl.font-bold.text-primary= (@recipe.food.calories * serving_factor).round
      .text-xs.text-text-secondary kcal
  .grid.grid-cols-4.gap-2.text-center
    .text-center
      .text-base.font-bold.text-text= "#{(@recipe.food.protein * serving_factor).round(1)}g"
      .text-xs.text-text-secondary= t('macros.protein')
    .text-center
      .text-base.font-bold.text-text= "#{(@recipe.food.carbs * serving_factor).round(1)}g"
      .text-xs.text-text-secondary= t('macros.carbs')
    .text-center
      .text-base.font-bold.text-text= "#{(@recipe.food.fat * serving_factor).round(1)}g"
      .text-xs.text-text-secondary= t('macros.fat')
    .text-center
      .text-base.font-bold.text-text= "#{(@recipe.food.fiber * serving_factor).round(1)}g"
      .text-xs.text-text-secondary= t('macros.fiber')

= render CardComponent.new(class: "p-4 mb-4") do
  %h2.text-base.font-bold.text-text.mb-1
    Per 100g
    %span.text-text-secondary.font-normal.ml-1 (reference)
  .grid.grid-cols-5.gap-2.text-center.mt-3
    .text-center
      .text-base.font-bold.text-text= @recipe.food.calories.round
      .text-xs.text-text-secondary kcal
    .text-center
      .text-base.font-bold.text-text= "#{@recipe.food.protein.round(1)}g"
      .text-xs.text-text-secondary= t('macros.protein')
    .text-center
      .text-base.font-bold.text-text= "#{@recipe.food.carbs.round(1)}g"
      .text-xs.text-text-secondary= t('macros.carbs')
    .text-center
      .text-base.font-bold.text-text= "#{@recipe.food.fat.round(1)}g"
      .text-xs.text-text-secondary= t('macros.fat')
    .text-center
      .text-base.font-bold.text-text= "#{@recipe.food.fiber.round(1)}g"
      .text-xs.text-text-secondary= t('macros.fiber')

= render CardComponent.new(class: "p-4 mb-4") do
  %h2.text-base.font-bold.text-text.mb-3 Ingredients
  - if @recipe_ingredients.any?
    .divide-y.divide-border
      - @recipe_ingredients.each do |ingredient|
        - ing_cal = (ingredient.food.calories * ingredient.weight / 100).round
        .py-2.flex.justify-between.items-center
          .min-w-0.flex-1
            .text-text.truncate= ingredient.food.name
            .text-xs.text-text-secondary= "#{ingredient.weight.to_i}g"
          .text-sm.font-medium.text-text.whitespace-nowrap.ml-3= "#{ing_cal} kcal"
  - else
    %p.text-sm.text-text-secondary No ingredients

.flex.gap-3
  = link_to edit_recipe_path(@recipe), class: "flex-1" do
    = render ButtonComponent.new(label: "Edit", scheme: :secondary, size: :md, class: "w-full")
  = button_to recipe_path(@recipe), method: :delete, data: { turbo_confirm: "Delete this recipe?" }, class: "flex-1", form: { class: "flex-1" } do
    = render ButtonComponent.new(label: "Delete", scheme: :danger, size: :md, class: "w-full")
