!!!
%html{lang: "en"}
  %head
    %meta{content: "text/html; charset=UTF-8", "http-equiv": "Content-Type"}/
    %title= @page_title || "Tally — calorie tracking without the clutter"
    %meta{name: "viewport", content: "width=device-width,initial-scale=1"}/
    %meta{name: "description", content: "Log what you eat in a few taps. Barcode scanning, your own foods, recipes, and calories plus macros against targets you set. No ads, no tracking."}
    %meta{name: "theme-color", content: "#16A34A"}/
    = csrf_meta_tags
    = csp_meta_tag
    %link{href: "/icon.png", rel: "icon", type: "image/png"}/
    %link{href: "/icon.svg", rel: "icon", type: "image/svg+xml"}/
    %link{href: "/apple-touch-icon.png", rel: "apple-touch-icon"}/
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-bg.text-text.font-sans.antialiased
    = yield
