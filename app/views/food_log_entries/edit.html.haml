%h1.text-xl.font-bold.mb-4 Edit Entry

= render CardComponent.new(class: "p-4") do
  %p.font-medium.text-text.mb-1= @entry.food.name
  %p.text-sm.text-text-secondary.mb-4= "#{@entry.food.calories.round} kcal per 100g"

  = form_with model: @entry, url: day_food_log_entry_path(day_date: @date.iso8601, id: @entry.id), method: :patch do |f|
    %div{ data: { controller: "quantity-preview", quantity_preview_calories_per100_value: @entry.food.calories.to_f, quantity_preview_protein_per100_value: @entry.food.protein.to_f, quantity_preview_carbs_per100_value: @entry.food.carbs.to_f, quantity_preview_fat_per100_value: @entry.food.fat.to_f, quantity_preview_fiber_per100_value: @entry.food.fiber.to_f } }
      .mb-4
        = f.label :weight, "Grams", class: "label"
        = f.number_field :weight, step: 0.01, min: 0.01, class: "input w-full", autofocus: true, data: { quantity_preview_target: "input", action: "input->quantity-preview#update" }
        - if @entry.errors[:weight].any?
          %p.field-error= @entry.errors[:weight].first

      .flex.justify-between.items-center.gap-3.mt-4.text-sm
        %p.text-text-secondary
          %span{ data: { quantity_preview_target: "calories" } }= @entry.calories.round
          |  kcal
          %span.mx-1 &middot;
          | P
          %span{ data: { quantity_preview_target: "protein" } }= @entry.protein.round(1)
          | g
          %span.mx-1 &middot;
          | C
          %span{ data: { quantity_preview_target: "carbs" } }= @entry.carbs.round(1)
          | g
          %span.mx-1 &middot;
          | F
          %span{ data: { quantity_preview_target: "fat" } }= @entry.fat.round(1)
          | g

    .mt-6.space-y-3
      = render ButtonComponent.new(label: "Save", tag: :input, type: :submit)
      .text-center
        = link_to "Delete entry", day_food_log_entry_path(day_date: @date.iso8601, id: @entry.id), data: { turbo_method: :delete, turbo_confirm: "Delete this entry?" }, class: "text-danger text-sm font-medium"
