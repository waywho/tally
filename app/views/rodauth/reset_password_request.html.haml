= render CardComponent.new(class: "p-6") do
  %h2.text-lg.font-semibold.text-text.text-center.mb-4= @page_title
  %p.text-sm.text-text-secondary.mb-4 Enter your email and we'll send you a link to reset your password.
  = form_tag rodauth.reset_password_request_path, method: :post do
    .mb-4
      %label.label{for: "email"}= rodauth.login_label
      %input.input{type: "email", name: "email", id: "email", value: rodauth.param_or_nil("email"), autofocus: true, autocomplete: "email"}
    = render ButtonComponent.new(label: "Send reset link", tag: :button, type: "submit", class: "w-full")
.mt-4.text-center.text-sm
  %p
    %a.text-primary.font-medium{href: rodauth.login_path} Back to login
