= render CardComponent.new(class: "p-6") do
  %h2.text-lg.font-semibold.text-text.mb-4= @page_title
  %p.text-sm.text-text-secondary.mb-4 We've sent a verification email to your address. Check your inbox and click the link to verify your account.
  = form_tag rodauth.verify_account_resend_path, method: :post do
    = render ButtonComponent.new(label: "Resend Verification Email", tag: :button, type: "submit", class: "w-full")
.mt-4.text-center.text-sm
  %p
    %a.text-primary.font-medium{href: rodauth.login_path} Back to login
