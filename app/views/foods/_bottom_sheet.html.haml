%div.hidden.fixed.inset-0.z-50.flex.items-end.justify-center{ style: "background: rgba(0,0,0,0.5);", data: { sheet_target: "overlay", action: "click->sheet#closeOnOverlay" } }
  %div.bg-bg.rounded-t-xl.w-full.max-w-lg{ style: "max-height: 85vh; display: flex; flex-direction: column;", data: { sheet_target: "panel" } }
    -# Drag handle
    .flex.justify-center.pt-3.pb-1
      .w-10.h-1.rounded-full.bg-border

    -# Header
    .flex.justify-between.items-start.px-5.pt-2.pb-1
      .min-w-0.flex-1.mr-3
        %h2.text-base.font-bold.text-text.truncate{ data: { sheet_target: "foodName" } }
        %p.text-xs.text-text-secondary{ data: { sheet_target: "foodCalories" } }
      %button.text-text-secondary.text-xl.shrink-0{ data: { action: "click->sheet#close" } } &times;

    = form_with url: day_food_log_entries_path(day_date: @date), method: :post, style: "display: flex; flex-direction: column; flex: 1; min-height: 0;" do |f|
      %input{ type: "hidden", name: "food_log_entry[meal]", value: @meal }
      %input{ type: "hidden", name: "food_log_entry[food_id]", data: { sheet_target: "foodIdField" } }
      %input{ type: "hidden", name: "usda_fdc_id", disabled: true, data: { sheet_target: "usdaFdcIdField" } }
      %input{ type: "hidden", name: "usda_name", disabled: true, data: { sheet_target: "usdaNameField" } }
      %input{ type: "hidden", name: "usda_calories", disabled: true, data: { sheet_target: "usdaCaloriesField" } }
      %input{ type: "hidden", name: "usda_protein", disabled: true, data: { sheet_target: "usdaProteinField" } }
      %input{ type: "hidden", name: "usda_carbs", disabled: true, data: { sheet_target: "usdaCarbsField" } }
      %input{ type: "hidden", name: "usda_fat", disabled: true, data: { sheet_target: "usdaFatField" } }
      %input{ type: "hidden", name: "usda_fiber", disabled: true, data: { sheet_target: "usdaFiberField" } }

      -# Scrollable content
      .px-5.py-3{ style: "overflow-y: auto; flex: 1;" }
        %div{ data: { controller: "quantity-preview" } }
          .mb-3
            = label_tag :weight, "Grams", class: "label"
            %input.input.w-full.text-center.text-xl.font-bold{ type: "number", name: "food_log_entry[weight]", step: "0.01", min: "0.01", placeholder: "0", autofocus: true, data: { quantity_preview_target: "input", action: "input->quantity-preview#update" } }

          .bg-primary-tint.rounded-md.px-3.py-2
            .flex.items-baseline.gap-1
              %span.text-base.font-bold.text-text{ data: { quantity_preview_target: "calories" } } 0
              %span.text-xs.text-text-secondary kcal
            .flex.gap-3.mt-1.text-xs.text-text-secondary
              %span
                = t('macros.protein')
                %b.text-text{ data: { quantity_preview_target: "protein" } } 0
                g
              %span
                = t('macros.carbs')
                %b.text-text{ data: { quantity_preview_target: "carbs" } } 0
                g
              %span
                = t('macros.fat')
                %b.text-text{ data: { quantity_preview_target: "fat" } } 0
                g
              %span
                = t('macros.fiber')
                %b.text-text{ data: { quantity_preview_target: "fiber" } } 0
                g

      -# Sticky button footer
      .px-5.py-4
        = render ButtonComponent.new(label: "Add to #{@meal&.capitalize}", tag: :input, type: :submit, class: "w-full")
