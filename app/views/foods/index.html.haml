%div{ data: { controller: @meal.present? ? "sheet" : nil } }
  .sticky.top-0.z-20.bg-bg-page.-mx-4.-mt-6.px-4.pt-6.pb-2
    - if @meal.present?
      %h1.text-xl.font-bold.mb-1 Add Food
    - else
      = render PageHeaderComponent.new(title: "My Foods") do |h|
        - h.with_action do
          = link_to new_food_path, "aria-label": "New food", class: "flex items-center justify-center w-11 h-11 text-primary rounded-lg hover:bg-primary-tint border border-primary transition-colors" do
            != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>'

    - if @meal.present? && @date.present?
      - parsed_date = (Date.parse(@date) rescue Date.current)
      - date_label = parsed_date == Date.current ? "Today, #{parsed_date.strftime('%b %-d')}" : parsed_date.strftime('%b %-d, %Y')
      %div.mb-2{ data: { meal_context: true } }
        .flex.items-center.gap-1.text-base.text-text-secondary.font-medium.mb-1
          %span Adding to
          = link_to meal_picker_path(meal: @meal, date: @date, q: @query.presence), class: "text-primary font-semibold inline-flex items-center gap-1", data: { turbo_frame: "modal", action: "click->modal#open" } do
            = @meal.capitalize
            != '<svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg>'
          %span &middot; #{date_label}
        - if @meal_totals
          .bg-primary-tint.-mx-4.px-4.py-2.flex.items-center.gap-x-2.text-xs.text-text-secondary
            %span.font-medium.text-text= "#{@meal_totals[:calories].round} kcal"
            %span
              = t('macros.protein')
              %span.font-medium.text-text= "#{@meal_totals[:protein].round(1)}g"
            %span
              = t('macros.carbs')
              %span.font-medium.text-text= "#{@meal_totals[:carbs].round(1)}g"
            %span
              = t('macros.fat')
              %span.font-medium.text-text= "#{@meal_totals[:fat].round(1)}g"
            %span
              = t('macros.fiber')
              %span.font-medium.text-text= "#{@meal_totals[:fiber].round(1)}g"

    = form_with url: foods_path, method: :get, data: { controller: "search", search_target: "form", turbo_frame: "food_search_results" } do
      - if @meal.present?
        %input{ type: "hidden", name: "meal", value: @meal }
      - if @date.present?
        %input{ type: "hidden", name: "date", value: @date }
      .relative{ native_app? ? { data: { controller: "barcode-scanner", barcode_scanner_mode_value: "search", barcode_scanner_meal_value: @meal, barcode_scanner_date_value: @date } } : {} }
        %input.input.w-full.pl-10.pr-10.peer{ type: "text", name: "q", value: @query, placeholder: "Search foods...", autocomplete: "off", data: { search_target: "input", action: "input->search#debounce" } }
        %div.absolute.left-3{ class: "top-1/2 -translate-y-1/2 text-text-secondary" }
          != '<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>'
        - if native_app?
          %button.absolute.right-3.text-text-secondary.hidden{ type: "button", "aria-label": "Scan barcode", class: "top-1/2 -translate-y-1/2 hover:text-text peer-placeholder-shown:block", data: { action: "click->barcode-scanner#scan" } }
            != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 013.75 9.375v-4.5zM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5zM14.25 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 01-1.125-1.125v-4.5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M14.25 14.625v6.75h6.75v-6.75h-6.75z"/></svg>'
        %button.absolute.right-3.text-xl.leading-none.text-text-secondary{ type: "button", "aria-label": "Clear search", class: "top-1/2 -translate-y-1/2 peer-placeholder-shown:hidden hover:text-text", data: { action: "click->search#clear" } } &times;

  - if params[:barcode_not_found].present?
    .bg-amber-50.border.border-amber-200.rounded-lg.px-4.py-3.mb-3.text-sm
      %p.text-amber-800
        Barcode #{params[:barcode]} not found.
        = link_to "Create a custom food", new_food_path(barcode: params[:barcode]), class: "text-primary font-semibold"
        with this barcode.

  = render "meal_templates/templates_section", meal_templates: @meal_templates, date: @date, meal: @meal

  = render "quick_add", quick_add_foods: @quick_add_foods, last_weights: @quick_add_last_weights

  = turbo_frame_tag "food_search_results", class: "block mt-1" do
    = render "results"

  - if @meal.present? && @date.present?
    = render "bottom_sheet"

  - if @barcode_food.present? && @meal.present?
    :javascript
      requestAnimationFrame(function() {
        const sheet = document.querySelector("[data-controller='sheet']")
        if (!sheet) return

        const overlay = sheet.querySelector("[data-sheet-target='overlay']")
        const foodName = sheet.querySelector("[data-sheet-target='foodName']")
        const foodCal = sheet.querySelector("[data-sheet-target='foodCalories']")
        const foodIdField = sheet.querySelector("[data-sheet-target='foodIdField']")
        const previewEl = sheet.querySelector("[data-controller='quantity-preview']")

        if (foodName) foodName.textContent = "#{j @barcode_food.name}"
        if (foodCal) foodCal.textContent = "#{@barcode_food.calories.to_f.round} kcal per 100g"
        if (foodIdField) { foodIdField.value = "#{@barcode_food.id}"; foodIdField.disabled = false }

        if (previewEl) {
          previewEl.dataset.quantityPreviewCaloriesPer100Value = "#{@barcode_food.calories.to_f}"
          previewEl.dataset.quantityPreviewProteinPer100Value = "#{@barcode_food.protein.to_f}"
          previewEl.dataset.quantityPreviewCarbsPer100Value = "#{@barcode_food.carbs.to_f}"
          previewEl.dataset.quantityPreviewFatPer100Value = "#{@barcode_food.fat.to_f}"
          previewEl.dataset.quantityPreviewFiberPer100Value = "#{@barcode_food.fiber.to_f}"
          var input = previewEl.querySelector("input[type='number']")
          if (input) { input.value = "100"; input.dispatchEvent(new Event("input")) }
        }

        if (overlay) { overlay.classList.remove("hidden"); document.body.classList.add("overflow-hidden") }
      })
