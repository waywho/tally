%div{ data: { controller: @meal.present? ? "sheet" : nil } }
  .sticky.top-0.z-20.bg-bg-page.-mx-4.-mt-6.px-4.pt-6.pb-2
    %h1.text-xl.font-bold.mb-1= @meal.present? ? "Add Food" : "Search Foods"

    - if @meal.present? && @date.present?
      - parsed_date = (Date.parse(@date) rescue Date.current)
      - date_label = parsed_date == Date.current ? "Today, #{parsed_date.strftime('%b %-d')}" : parsed_date.strftime('%b %-d, %Y')
      %div.mb-2{ data: { meal_context: true } }
        .flex.items-center.gap-1.text-sm.text-text-secondary.font-medium.mb-1
          %span Adding to
          = form_with url: foods_path, method: :get, class: "inline-flex", data: { turbo_frame: "_top" } do
            %input{ type: "hidden", name: "date", value: @date }
            - if @query.present?
              %input{ type: "hidden", name: "q", value: @query }
            %select.text-primary.font-semibold.bg-transparent.border-0.p-0.pr-5.cursor-pointer.appearance-none{ name: "meal", "aria-label": "Meal", onchange: "this.form.submit()", style: "background-image: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' fill='%2316A34A'><path d='M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z'/></svg>\"); background-repeat: no-repeat; background-position: right center; background-size: 14px 14px;" }
              - FoodLogEntry.meals.each_key do |meal_key|
                %option{ value: meal_key, selected: (meal_key == @meal) }= meal_key.capitalize
          %span &middot; #{date_label}
        - if @meal_totals && @meal_totals[:calories] > 0
          .bg-primary-tint.-mx-4.px-4.py-2.flex.items-center.gap-x-2.text-xs.text-text-secondary
            %span.font-medium.text-text= "#{@meal_totals[:calories].round} kcal"
            %span
              = t('macros.protein')
              %span.font-medium.text-text= "#{@meal_totals[:protein].round(1)}g"
            %span
              = t('macros.carbs')
              %span.font-medium.text-text= "#{@meal_totals[:carbs].round(1)}g"
            %span
              = t('macros.fat')
              %span.font-medium.text-text= "#{@meal_totals[:fat].round(1)}g"
            %span
              = t('macros.fiber')
              %span.font-medium.text-text= "#{@meal_totals[:fiber].round(1)}g"

    = form_with url: foods_path, method: :get, data: { controller: "search", search_target: "form", turbo_frame: "food_search_results" } do
      - if @meal.present?
        %input{ type: "hidden", name: "meal", value: @meal }
      - if @date.present?
        %input{ type: "hidden", name: "date", value: @date }
      .relative
        %input.input.w-full.pl-10.pr-10.peer{ type: "text", name: "q", value: @query, placeholder: "Search foods...", autocomplete: "off", data: { search_target: "input", action: "input->search#debounce" } }
        %div.absolute.left-3{ class: "top-1/2 -translate-y-1/2 text-text-secondary" }
          != '<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35" stroke-linecap="round"/></svg>'
        %button.absolute.right-3.text-xl.leading-none.text-text-secondary{ type: "button", "aria-label": "Clear search", class: "top-1/2 -translate-y-1/2 peer-placeholder-shown:hidden hover:text-text", data: { action: "click->search#clear" } } &times;

  = render "meal_templates/templates_section", meal_templates: @meal_templates, date: @date, meal: @meal

  = render "quick_add", quick_add_foods: @quick_add_foods, last_weights: @quick_add_last_weights

  = turbo_frame_tag "food_search_results", class: "block mt-1" do
    = render "results"

  - if @meal.present? && @date.present?
    = render "bottom_sheet"
