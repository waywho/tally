- @page_title = "Save as Template"
- back_href = @date.present? ? day_path(date: @date) : today_path

= render PageHeaderComponent.new(title: "Save as template", back_href: back_href, back_label: "Back")

= form_with model: @meal_template, url: meal_templates_path, method: :post do |f|
  %input{ type: "hidden", name: "date", value: @date }
  %input{ type: "hidden", name: "meal", value: @meal }

  = render CardComponent.new(class: "p-6 mb-4") do
    %h2.text-base.font-bold.text-text.mb-4 Template name
    %div
      = f.text_field :name, class: "input", maxlength: 255, required: true, placeholder: "e.g. Weekday breakfast"
      - if @meal_template.errors[:name].any?
        %p.field-error= @meal_template.errors[:name].first

  - if @entries.any?
    = render CardComponent.new(class: "p-4 mb-4") do
      %h2.text-base.font-bold.text-text.mb-3 Foods to save
      .divide-y.divide-border
        - @entries.each do |entry|
          .py-2.flex.justify-between.items-center{ data: { preview_item: true } }
            .min-w-0.flex-1
              .text-text.truncate= entry.food.name
              .text-xs.text-text-secondary= "#{entry.weight.to_i}g"
            .text-sm.font-medium.text-text.whitespace-nowrap.ml-3= "#{entry.calories.round} kcal"

    = render ButtonComponent.new(label: "Save template", tag: :button, type: "submit", class: "w-full")
  - else
    %div{ data: { empty_preview: true } }
      = render CardComponent.new(class: "p-8 text-center") do
        %p.text-text-secondary.mb-1 No entries found for this meal.
        %p.text-sm.text-text-secondary Log some foods first, then save as a template.
