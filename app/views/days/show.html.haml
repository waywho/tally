%div{ data: { date: @date.iso8601 } }
  .flex.justify-end.mb-2
    = link_to edit_settings_path, class: "flex items-center justify-center w-9 h-9 text-text-secondary hover:text-text rounded-lg hover:bg-primary-tint transition-colors", "aria-label": "Settings" do
      != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 010-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>'

  .flex.items-center.justify-between.mb-4
    = link_to day_path(date: (@date - 1.day).iso8601), class: "flex items-center justify-center w-11 h-11 text-text-secondary hover:text-text rounded-lg hover:bg-primary-tint border border-border transition-colors" do
      != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>'
    .text-center{ data: { controller: "date-picker" } }
      %h1.text-lg.font-semibold.text-text.cursor-pointer{ data: { action: "click->date-picker#open" } }
        = @date == Date.current ? "Today" : @date.strftime("%A")
      %p.text-sm.text-text-secondary.cursor-pointer{ data: { action: "click->date-picker#open" } }= @date.strftime("%b %-d, %Y")
      %input.sr-only{ type: "date", value: @date.iso8601, data: { date_picker_target: "input", action: "change->date-picker#navigate" } }
    = link_to day_path(date: (@date + 1.day).iso8601), class: "flex items-center justify-center w-11 h-11 text-text-secondary hover:text-text rounded-lg hover:bg-primary-tint border border-border transition-colors" do
      != '<svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>'

  -# Calorie summary card
  %div{ data: { calorie_summary: true } }
    = render CaloriePillComponent.new(eaten: @daily_totals[:calories].round, target: @daily_totals[:target_calories], protein: "#{@daily_totals[:protein].round}g / #{@daily_totals[:target_protein]}g", carbs: "#{@daily_totals[:carbs].round}g / #{@daily_totals[:target_carbs]}g", fat: "#{@daily_totals[:fat].round}g / #{@daily_totals[:target_fat]}g", fiber: "#{@daily_totals[:fiber].round}g / #{@daily_totals[:target_fiber]}g")

  -# Meal buckets
  .mt-2.space-y-2
    - FoodLogEntry.meals.each_key do |meal|
      - entries = @entries_by_meal[meal]
      - subtotal = @meal_totals[meal][:calories].round
      - meal_macros = @meal_totals[meal]
      - add_path = foods_path(meal: meal, date: @date.iso8601)

      %div{ data: { meal: meal } }
        = render CardComponent.new do
          = render BucketHeaderComponent.new(meal: meal.capitalize, subtotal: subtotal, add_path: add_path, protein: meal_macros[:protein], carbs: meal_macros[:carbs], fat: meal_macros[:fat], fiber: meal_macros[:fiber])

          - if entries.any?
            - entries.each do |entry|
              = link_to edit_day_food_log_entry_path(day_date: @date.iso8601, id: entry.id), class: "block" do
                .flex.justify-between.items-start.px-4.py-3.border-b.border-border{ data: { entry_id: entry.id } }
                  .min-w-0.flex-1
                    %p.text-sm.font-medium.text-text.truncate= entry.food.name
                    .flex.flex-wrap.gap-2.mt-1
                      %span.text-xs.text-text-secondary
                        %span.font-medium.text-text= t('macros.protein')
                        = " #{entry.protein.round(1)}g"
                      %span.text-xs.text-text-secondary
                        %span.font-medium.text-text= t('macros.carbs')
                        = " #{entry.carbs.round(1)}g"
                      %span.text-xs.text-text-secondary
                        %span.font-medium.text-text= t('macros.fat')
                        = " #{entry.fat.round(1)}g"
                      %span.text-xs.text-text-secondary
                        %span.font-medium.text-text= t('macros.fiber')
                        = " #{entry.fiber.round(1)}g"
                  .text-right.ml-3.shrink-0
                    %p.text-sm.font-medium.text-text= "#{entry.calories.round} kcal"
                    %p.text-xs.text-text-secondary.mt-1= "#{entry.weight.to_i}g"
            .px-4.py-2.text-center
              = link_to "Save as template", new_meal_template_path(date: @date.iso8601, meal: meal), class: "text-xs text-primary font-medium", data: { save_template: true }
          - else
            .px-4.py-6.text-center.text-text-secondary.text-sm{ data: { empty_meal: true } }
              %p No foods logged yet
              = link_to "+ Add food", add_path, class: "text-primary font-medium mt-2 inline-block px-3 py-1 rounded-md hover:bg-primary-tint transition-colors"
