.flex.items-center.gap-3.mb-4
  - if @back_href
    = link_to @back_href, "aria-label": @back_label, class: "flex items-center justify-center w-11 h-11 text-text-secondary hover:text-text rounded-lg hover:bg-primary-tint border border-border transition-colors shrink-0" do
      != PageHeaderComponent::BACK_ARROW_SVG
  %h1.text-xl.font-bold.flex-1.truncate{ class: @back_href ? "text-center" : nil }= @title
  - if action?
    .shrink-0= action
  - elsif @back_href
    .w-11.h-11.shrink-0
